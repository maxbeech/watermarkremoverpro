{
  "name": "markwitness",
  "version": "0.1.0",
  "private": true,
  "description": "MarkWitness: check your own writing for a statistical AI provenance mark, on your device.",
  "scripts": {
    "dev": "next dev -p 3540",
    "build": "next build",
    "start": "next start -p 3540",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && tsx scripts/mcp-smoke.mts",
    "test:watch": "vitest",
    "test:models": "tsx scripts/test-advanced-backend.mts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "baselines": "tsx scripts/build-baselines.ts",
    "corpus": "tsx scripts/fetch-corpus.ts",
    "mcp": "tsx mcp/server.ts",
    "build:rewrite-engine": "tsup --config tsup.rewrite-engine.config.ts",
    "db:push": "tsx scripts/db-push.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^10.71.0",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.4.4",
    "next": "^16.3.4",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "stripe": "^22.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "16.2.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "typescript-eslint": "^8.63.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "adm-zip": "^0.6.0",
    "esbuild": "^0.28.2"
  }
}
