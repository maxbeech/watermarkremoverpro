# Public site URL. Must match the deployment origin, because Better Auth signs callbacks
# against it, and llms.txt, pricing.json, the OpenAPI document and the JSON-LD all
# advertise it.
NEXT_PUBLIC_SITE_URL=https://watermarkremoverpro.com

# ---------------------------------------------------------------------------
# Neon Postgres.
#
# Absent, the on-device check at /check works completely normally, and it does not
# touch the database at all. Accounts, saved history, API keys, usage metering
# and the evidence report return an explicit 503 naming this variable, rather
# than silently serving unmetered or pretending a quota was checked.
DATABASE_URL=

# Better Auth session signing secret. At least 32 random characters.
#   openssl rand -base64 48
# Absent, auth() throws rather than starting an auth system whose sessions could
# be forged.
BETTER_AUTH_SECRET=

# ---------------------------------------------------------------------------
# Stripe.
#
# Absent, the pricing page shows paid plans as unavailable rather than
# rendering a checkout button that fails, and /api/billing/checkout returns
# 503. Configured on the current production deployment; see CHANGELOG.md.
STRIPE_SECRET_KEY=
# The recurring price id for the Pro subscription.
STRIPE_PRICE_PRO=
# Webhook signing secret. Absent, webhook events are REJECTED rather than trusted
# unverified, because an unverified event could upgrade any account to Pro.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Additional detection keys.
#
# A JSON array of { id, label, secret, gamma?, provenance?, vendorPublished? }.
#
# This is the path a model vendor publishing a detection key, or an institution
# issued one under agreement, plugs into. The engine needs no change to test
# against it, and results will list it among keysTested.
#
# Set vendorPublished: true ONLY for a key published by the party that generates
# the mark. That flag changes the wording of every "no mark detected" result, so
# setting it wrongly makes the product overclaim.
#
# Malformed JSON here throws at startup rather than silently running with fewer
# keys than the operator believes are active.
MARKWITNESS_DETECTION_KEYS=

# --- ThreadCamp (transactional email) ---------------------------------------
# This product sends through ThreadCamp (threadcamp.com), on its own account
# and its own inbox, currently on the shared relay.threadcamp.com domain.
# Without both values, sendEmail() returns { sent: false, reason: "not_configured" }
# and never pretends to have sent.
THREADCAMP_API_KEY=
THREADCAMP_FROM_ADDRESS=
# Optional. Defaults to https://www.threadcamp.com/v1
# THREADCAMP_API_URL=
# Optional display name on outbound mail (defaults to the product name).
# THREADCAMP_FROM_NAME=
